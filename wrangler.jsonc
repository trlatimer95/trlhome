// Cloudflare Workers static-assets config for the Git-connected build.
// `name` must match the Worker's name in the Cloudflare dashboard.
// Without this file Cloudflare falls back to single-page-app mode, which serves
// index.html with a 200 for unknown URLs instead of 404.html with a 404.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trlhome",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
